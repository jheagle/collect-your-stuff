{
  "name": "collect-your-stuff",
  "description": "Use a variety of collections to collect your stuff when building code.",
  "version": "2.2.1",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "author": "Joshua Heagle",
  "license": "GNU",
  "keywords": [
    "collections",
    "linkedlist",
    "map",
    "nodelist",
    "arraylist"
  ],
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "test": "gulp testFull",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "devDependencies": {
    "js-build-tools": "^6.3.0",
    "release-it": "^21.1.1",
    "typedoc": "^0.28.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/collections.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/collections/issues"
  },
  "homepage": "https://github.com/jheagle/collections#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "files": [
    "dist",
    "browser"
  ],
  "dependencies": {
    "core-js": "^3.51.0"
  }
