{
  "browser": {
    "name": "collect-your-stuff"
  },
  "copyFiles": [
    {
      "from": "browser/*.js",
      "to": "../joshuaheagle.local/projects/collect-your-stuff/browser"
    }
  ],
  "dist": {
    "main": "dist/browser"
  },
  "docs": {
    "bodyHtml": "<script data-goatcounter=\"https://joshuaheagle.goatcounter.com/count\" async src=\"//gc.zgo.at/count.js\"></script>",
    "enabled": true,
    "from": "src",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/collect-your-stuff/docs",
    "inBuild": false,
    "gitRevision": "main"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  },
  "lint": {
    "rules": {
      "new-cap": [
        "error",
        {
          "newIsCapExceptionPattern": "(^|\\.)(classType|listClass|linkerClass)$"
        }
      ]
    }
  }
}
