{
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.*"
  ],
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "target": "es6",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "declaration": true,
    "types": []
  }
}
